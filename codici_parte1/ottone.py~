import pandas as pd
import numpy as np

# 1. PARAMETRI COSTANTI DELL'ESPERIMENTO
M_E = 25.0    # Massa equivalente in acqua del thermos (in grammi)
C_W = 1.00    # Calore specifico dell'acqua in cal/(g * °C)

NOME_FILE = 'Dati e annotazioni - 0.2 Ottone.csv'

# 2. LETTURA CSV DISPOSTO PER RIGHE E TRASPOSIZIONE
df_raw = pd.read_csv(
    NOME_FILE, 
    header=None, 
    sep=None, 
    decimal=',', 
    engine='python'
)

# Ruotiamo righe e colonne (trasposizione)
df_ottone = df_raw.T.copy()

# Assegniamo i nomi alle righe rispettando l'ordine del CSV
nomi_colonne = ['materiale', 'T1', 'm_a', 'm_c', 'Ta', 'Tf']
df_ottone.columns = nomi_colonne

# Convertiamo in float le colonne numeriche
colonne_numeriche = ['m_c', 'm_a', 'T1', 'Ta', 'Tf']
df_ottone[colonne_numeriche] = df_ottone[colonne_numeriche].astype(float)

# 3. CALCOLO DEL CALORE SPECIFICO c IN CALORIE
# Formula: c = ((m_a + M_e) * c_w * (Tf - Ta)) / (m_c * (T1 - Tf))
df_ottone['c_cal_gC'] = (
    (df_ottone['m_a'] + M_E) * C_W * (df_ottone['Tf'] - df_ottone['Ta'])
) / (df_ottone['m_c'] * (df_ottone['T1'] - df_ottone['Tf']))

# 4. STAMPA DELLE SINGOLE MISURE
print("=== MISURE DI DETTAGLIO OTTONE (cal/(g * °C)) ===")
print(df_ottone[['m_c', 'm_a', 'T1', 'Ta', 'Tf', 'c_cal_gC']])

# 5. ANALISI DELLA MEDIA E DISPERSIONE
n_misure = len(df_ottone)
media = df_ottone['c_cal_gC'].mean()
dev_std = df_ottone['c_cal_gC'].std()
errore_std = dev_std / np.sqrt(n_misure) if n_misure > 0 else 0

print("\n=== SINTESI STATISTICA OTTONE ===")
print(f"Numero di misure valide : {n_misure}")
print(f"Calore specifico medio  : {media:.3f} cal/(g °C)")
print(f"Deviazione standard (s) : {dev_std:.3f} cal/(g °C)")
print(f"Errore standard media   : {errore_std:.3f} cal/(g °C)")
